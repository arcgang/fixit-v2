{
  "info": {
    "title": "prometheus-grafana Observability API",
    "version": "1.0.0",
    "description": "Internal HTTP API exposed by the Prometheus/Grafana observability stack for health probes, alert-webhook ingestion from CloudWatch/SNS, and dashboard metadata queries."
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe for the observability stack",
        "security": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Stack is healthy"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "One or more components degraded"
          }
        },
        "operationId": "getHealth"
      }
    },
    "/api/v1/slo": {
      "get": {
        "tags": [
          "SLO"
        ],
        "summary": "List current SLO burn-rate and error-budget status for all defined SLOs",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SloListResponse"
                }
              }
            },
            "description": "Paginated SLO status list"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listSloStatus"
      }
    },
    "/api/v1/alerts": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "List recent firing or resolved alerts with cursor pagination",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertListResponse"
                }
              }
            },
            "description": "Paginated list of alerts"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Opaque pagination cursor"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          },
          {
            "in": "query",
            "name": "state",
            "schema": {
              "enum": [
                "firing",
                "resolved",
                "all"
              ],
              "type": "string",
              "default": "all"
            },
            "required": false
          }
        ],
        "operationId": "listAlerts"
      }
    },
    "/api/v1/dashboards": {
      "get": {
        "tags": [
          "Dashboards"
        ],
        "summary": "List available Grafana dashboard metadata with cursor pagination",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardListResponse"
                }
              }
            },
            "description": "Paginated list of dashboard metadata"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listDashboards"
      }
    },
    "/api/v1/slo/{sloId}": {
      "get": {
        "tags": [
          "SLO"
        ],
        "summary": "Retrieve current burn-rate and error-budget for a single SLO",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SloStatus"
                }
              }
            },
            "description": "SLO status"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "SLO not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "sloId",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "operationId": "getSloStatus"
      }
    },
    "/api/v1/alerts/webhook": {
      "post": {
        "tags": [
          "Alerts"
        ],
        "summary": "Receive alert notifications forwarded from Amazon SNS / CloudWatch Alarms",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Alert accepted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Malformed payload"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "operationId": "receiveAlertWebhook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertWebhookPayload"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/v1/scrape-targets": {
      "get": {
        "tags": [
          "Scrape Targets"
        ],
        "summary": "List all Prometheus scrape targets and their current UP/DOWN state",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScrapeTargetListResponse"
                }
              }
            },
            "description": "Paginated scrape target list"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            },
            "required": false
          }
        ],
        "operationId": "listScrapeTargets"
      }
    },
    "/api/v1/alerts/{alertId}": {
      "get": {
        "tags": [
          "Alerts"
        ],
        "summary": "Retrieve a single alert record by ID",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertRecord"
                }
              }
            },
            "description": "Alert record"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Alert not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "alertId",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true
          }
        ],
        "operationId": "getAlert"
      }
    },
    "/api/v1/dashboards/{dashboardId}": {
      "get": {
        "tags": [
          "Dashboards"
        ],
        "summary": "Retrieve metadata and panel definitions for a specific Grafana dashboard",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardDetail"
                }
              }
            },
            "description": "Dashboard metadata"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Unauthorised"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "Dashboard not found"
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "dashboardId",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "operationId": "getDashboard"
      }
    }
  },
  "openapi": "3.1.0",
  "servers": [
    {
      "url": "http://prometheus-grafana.monitoring.svc.cluster.local",
      "description": "In-cluster observability service"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code",
          "message",
          "correlation_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "message": {
            "type": "string"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SloStatus": {
        "type": "object",
        "required": [
          "id",
          "name",
          "target",
          "current_burn_rate",
          "error_budget_remaining_pct",
          "window_hours"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "e.g. api-availability, p95-latency, sse-connection-count"
          },
          "status": {
            "enum": [
              "ok",
              "warning",
              "critical"
            ],
            "type": "string"
          },
          "target": {
            "type": "number",
            "format": "double",
            "description": "SLO target as a ratio, e.g. 0.995"
          },
          "evaluated_at": {
            "type": "string",
            "format": "date-time"
          },
          "window_hours": {
            "type": "integer",
            "description": "Rolling window in hours, e.g. 720 for 30 days"
          },
          "current_burn_rate": {
            "type": "number",
            "format": "double"
          },
          "error_budget_remaining_pct": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "CursorPage": {
        "type": "object",
        "required": [
          "next_cursor",
          "limit"
        ],
        "properties": {
          "limit": {
            "type": "integer",
            "maximum": 200,
            "minimum": 1
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Opaque; null on the last page"
          }
        }
      },
      "AlertRecord": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "severity",
          "fired_at",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "firing",
              "resolved"
            ],
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source": {
            "enum": [
              "cloudwatch",
              "sns",
              "prometheus"
            ],
            "type": "string"
          },
          "fired_at": {
            "type": "string",
            "format": "date-time"
          },
          "severity": {
            "enum": [
              "critical",
              "warning",
              "info"
            ],
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "generator_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "InboundAlert": {
        "type": "object",
        "required": [
          "name",
          "state",
          "fired_at"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "firing",
              "resolved"
            ],
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fired_at": {
            "type": "string",
            "format": "date-time"
          },
          "severity": {
            "enum": [
              "critical",
              "warning",
              "info"
            ],
            "type": "string"
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resolved_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "generator_url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "ScrapeTarget": {
        "type": "object",
        "required": [
          "job",
          "instance",
          "state"
        ],
        "properties": {
          "job": {
            "type": "string",
            "description": "Prometheus job name, e.g. fixit-spring-boot-api, keycloak"
          },
          "state": {
            "enum": [
              "up",
              "down",
              "unknown"
            ],
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "instance": {
            "type": "string",
            "description": "host:port of the scrape target"
          },
          "last_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_scrape": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DashboardPanel": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "description": "e.g. graph, stat, table, gauge"
          },
          "title": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "description": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "components"
        ],
        "properties": {
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "type": "string"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ComponentHealth"
            }
          }
        }
      },
      "ComponentHealth": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "e.g. prometheus, grafana, alertmanager"
          },
          "status": {
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "DashboardDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DashboardSummary"
          },
          {
            "type": "object",
            "properties": {
              "panels": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DashboardPanel"
                }
              },
              "variables": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        ]
      },
      "SloListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SloStatus"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "required": [
          "id",
          "title",
          "uid",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "uid": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AlertListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlertRecord"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "AlertWebhookPayload": {
        "type": "object",
        "required": [
          "source",
          "alerts"
        ],
        "properties": {
          "alerts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InboundAlert"
            }
          },
          "source": {
            "enum": [
              "cloudwatch",
              "sns",
              "prometheus"
            ],
            "type": "string",
            "description": "Origin of the alert notification"
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DashboardListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DashboardSummary"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      },
      "ScrapeTargetListResponse": {
        "type": "object",
        "required": [
          "data",
          "page"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScrapeTarget"
            }
          },
          "page": {
            "$ref": "#/components/schemas/CursorPage"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
